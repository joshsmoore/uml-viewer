#!/bin/zsh
set -euo pipefail
TOOL="$(cd "$(dirname "$0")/.." && pwd)"
ROOT="$(pwd)"
DEPS="{:deps {uml-viewer/uml-viewer {:local/root \"$TOOL\"}}}"

edn_path() {
  local name base f
  name="$(basename "$ROOT")"
  if [[ -f "examples/${name}.edn" ]]; then
    echo "examples/${name}.edn"
    return
  fi
  if [[ -d examples ]]; then
    for f in examples/*.edn(N); do
      [[ -f "$f" ]] || continue
      base="${f:t}"
      [[ "$base" == *.policy.edn ]] && continue
      echo "$f"
      return
    done
  fi
}

LOG="uml-viewer-log.txt"

launch_viewer() {
  {
    printf '----- %s starting uml-viewer' "$(date '+%Y-%m-%d %H:%M:%S')"
    [[ $# -gt 0 ]] && printf ' %s' "$@"
    printf '\n'
  } >> "$LOG"
  nohup clojure -Sdeps "$DEPS" -M -m uml-viewer.main.uml-viewer "$@" >> "$LOG" 2>&1 </dev/null &
  disown
  echo "UML viewer started (pid $!). Log: $LOG"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "usage: uml [--restart] [--pr N|local]   (run from the project root)" >&2
  echo "  (no args)   opens the viewer in the browser; companion writes the diagram" >&2
  echo "  --restart   new JVM, same companion; restores last view" >&2
  echo "  --pr N      review GitHub PR N without checking it out" >&2
  echo "  --pr local  with --restart, back to the working tree" >&2
  echo "  The viewer detaches; exceptions go to $LOG." >&2
  exit 0
fi

if [[ "$(git rev-parse --show-toplevel 2>/dev/null)" != "$ROOT" ]]; then
  echo "uml: run from the root of a git project" >&2
  exit 1
fi

if [[ "${1:-}" == "--restart" ]]; then
  shift
  edn="$(edn_path)"
  if [[ -n "$edn" ]]; then
    launch_viewer --restart "$@" "$edn"
  else
    launch_viewer --restart "$@"
  fi
  exit 0
fi

launch_viewer "$@"
